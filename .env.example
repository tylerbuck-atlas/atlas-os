# Atlas OS environment configuration
# Copy to .env and set real values. Never commit .env.

# REQUIRED. The root credential for registering services with Atlas Core.
# Minimum 16 characters. Treat it like a root password.
ATLAS_BOOTSTRAP_TOKEN=change-me-to-a-long-random-secret

# Security mode: mtls (default, certificate identity) or token (dev only)
#ATLAS_SECURITY_MODE=mtls

# Optional overrides (defaults shown)
#ATLAS_CORE_HOST=0.0.0.0
#ATLAS_CORE_PORT=8000
#ATLAS_HEARTBEAT_INTERVAL_SECONDS=10
#ATLAS_HEARTBEAT_MISSES_ALLOWED=3
#ATLAS_PROBE_INTERVAL_SECONDS=15
#ATLAS_LOG_LEVEL=INFO
